# Copie a .env (NUNCA lo suba a git). Genere secretos con: python -c "import secrets;print(secrets.token_urlsafe(48))"
FLASK_ENV=production
SECRET_KEY=
# Usuario dueño de la base; con DB_ROL_APLICACION la app hace SET ROLE a ese rol limitado y aplica RLS entre clientes
DATABASE_URL=postgresql+psycopg://erp_owner:CLAVE@localhost:5432/erp
DB_ROL_APLICACION=erp_app
# Clave de cifrado de campos sensibles (Fernet): python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
LICENSE_SERVER_URL=https://licencias.su-dominio.com
LICENSE_PUBLIC_KEY=
# Consola del Maestro y tienda de licencias (mismo valor que en el servidor de licencias, ≥32 caracteres)
LICENSE_ADMIN_SECRET=
PAGO_MOVIL_INSTRUCCIONES=Banco …, teléfono …, RIF …
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Dominio público: los enlaces de los correos se construyen SOLO con este valor
APP_NOMBRE=Contax
APP_LEMA=Tu empresa en orden. Tu fisco al día.
APP_BASE_URL=https://erp.su-dominio.com

# Correo (verificación, invitaciones, recuperación, alertas y entrega de licencias) por la API de Brevo
MAIL_BACKEND=brevo
MAIL_FROM=Gigadevs Corp <aalejandro996@icloud.com>
BREVO_API_KEY=
# Primer Maestro (despliegue no interactivo: recibe una invitación por correo)
MAESTRO_USUARIO=
MAESTRO_EMAIL=
# (alternativa SMTP: MAIL_BACKEND=smtp)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=0

# ---- Servidor de licencias (servicio erp-licencias) ----
# LICENSE_PRIVATE_KEY=            (solo en ese servicio)
# PUBLIC_URL=https://erp-licencias.onrender.com
# ERP_URL=https://erp-web.onrender.com
# USDT con cuenta PERSONAL de Binance (Perfil → Gestión de API: SOLO «Permitir lectura»; sin trading ni retiros)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_PAY_ID=                 (su Pay ID, el que verá el cliente)
# BINANCE_USDT_RED=TRC20          (opcional: aceptar también depósitos por esa red…)
# BINANCE_USDT_DIRECCION=         (…a esta dirección de su cuenta)
